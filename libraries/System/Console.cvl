namespace System.Console;

// Isolate the low-level C-linkage printf here
extern void printf(string format, ...);
extern int getchar();

/// <summary>
/// Writes the specified string value, followed by the current line terminator, to the standard output stream.
/// </summary>
/// <param name="value">The string value to write to the console.</param>
void WriteLine(string value) {
    printf("%s\n", value);
}

/// <summary>
/// Writes the specified 32-bit signed integer, followed by the current line terminator, to the standard output stream.
/// </summary>
/// <param name="value">The integer value to write to the console.</param>
void WriteLine(int value) {
    printf("%d\n", value);
}

/// <summary>
/// Writes the specified 64-bit floating-point number, followed by the current line terminator, to the standard output stream.
/// </summary>
/// <param name="value">The double value to write to the console.</param>
void WriteLine(double value) {
    printf("%f\n", value); 
}

/// <summary>
/// Writes the text representation of the specified boolean value, followed by the current line terminator, to the standard output stream.
/// </summary>
/// <param name="value">The boolean value to write (renders as 1 for True, 0 for False).</param>
void WriteLine(bool value) {
    printf("%d\n", value);
}

/// <summary>
/// Writes the specified Unicode character, followed by the current line terminator, to the standard output stream.
/// </summary>
/// <param name="value">The character to write to the console.</param>
void WriteLine(char value) {
    printf("%c\n", value);
}

/// <summary>
/// Writes the specified 8-bit unsigned integer, followed by the current line terminator, to the standard output stream.
/// </summary>
/// <param name="value">The byte value to write to the console.</param>
void WriteLine(byte value) {
    printf("%hhu\n", (int)value);
}

/// <summary>
/// Writes the specified 8-bit signed integer, followed by the current line terminator, to the standard output stream.
/// </summary>
/// <param name="value">The sbyte value to write to the console.</param>
void WriteLine(sbyte value) {
    printf("%hhd\n", (int)value);
}

/// <summary>
/// Writes the specified 16-bit signed integer, followed by the current line terminator, to the standard output stream.
/// </summary>
/// <param name="value">The short value to write to the console.</param>
void WriteLine(short value) {
    printf("%hd\n", (int)value);
}

/// <summary>
/// Writes the specified 16-bit unsigned integer, followed by the current line terminator, to the standard output stream.
/// </summary>
/// <param name="value">The ushort value to write to the console.</param>
void WriteLine(ushort value) {
    printf("%hu\n", (int)value);
}

/// <summary>
/// Writes the specified 32-bit unsigned integer, followed by the current line terminator, to the standard output stream.
/// </summary>
/// <param name="value">The uint value to write to the console.</param>
void WriteLine(uint value) {
    printf("%u\n", (int)value);
}

/// <summary>
/// Writes the specified 64-bit signed integer, followed by the current line terminator, to the standard output stream.
/// </summary>
/// <param name="value">The long value to write to the console.</param>
void WriteLine(long value) {
    printf("%lld\n", value);
}

/// <summary>
/// Writes the specified 64-bit unsigned integer, followed by the current line terminator, to the standard output stream.
/// </summary>
/// <param name="value">The ulong value to write to the console.</param>
void WriteLine(ulong value) {
    printf("%llu\n", value);
}

/// <summary>
/// Writes the specified string value to the standard output stream.
/// </summary>
/// <param name="value">The string value to write to the console.</param>
void Write(string value) {
    printf("%s", value);
}

/// <summary>
/// Writes the specified 32-bit signed integer to the standard output stream.
/// </summary>
/// <param name="value">The integer value to write to the console.</param>
void Write(int value) {
    printf("%d", value);
}

/// <summary>
/// Writes the specified 64-bit floating-point number to the standard output stream.
/// </summary>
/// <param name="value">The double value to write to the console.</param>
void Write(double value) {
    printf("%f", value);
}

/// <summary>
/// Writes the text representation of the specified boolean value to the standard output stream.
/// </summary>
/// <param name="value">The boolean value to write (renders as 1 for True, 0 for False).</param>
void Write(bool value) {
    printf("%d", value);
}

/// <summary>
/// Writes the specified Unicode character to the standard output stream.
/// </summary>
/// <param name="value">The character to write to the console.</param>
void Write(char value) {
    printf("%c", value);
}

/// <summary>
/// Writes the specified 8-bit unsigned integer to the standard output stream.
/// </summary>
/// <param name="value">The byte value to write to the console.</param>
void Write(byte value) {
    printf("%hhu", (int)value);
}

/// <summary>
/// Writes the specified 8-bit signed integer to the standard output stream.
/// </summary>
/// <param name="value">The sbyte value to write to the console.</param>
void Write(sbyte value) {
    printf("%hhd", (int)value);
}

/// <summary>
/// Writes the specified 16-bit signed integer to the standard output stream.
/// </summary>
/// <param name="value">The short value to write to the console.</param>
void Write(short value) {
    printf("%hd", (int)value);
}

/// <summary>
/// Writes the specified 16-bit unsigned integer to the standard output stream.
/// </summary>
/// <param name="value">The ushort value to write to the console.</param>
void Write(ushort value) {
    printf("%hu", (int)value);
}

/// <summary>
/// Writes the specified 32-bit unsigned integer to the standard output stream.
/// </summary>
/// <param name="value">The uint value to write to the console.</param>
void Write(uint value) {
    printf("%u", (int)value);
}

/// <summary>
/// Writes the specified 64-bit signed integer to the standard output stream.
/// </summary>
/// <param name="value">The long value to write to the console.</param>
void Write(long value) {
    printf("%lld", value);
}

/// <summary>
/// Writes the specified 64-bit unsigned integer to the standard output stream.
/// </summary>
/// <param name="value">The ulong value to write to the console.</param>
void Write(ulong value) {
    printf("%llu", value);
}

/// <summary>
/// Reads the next character from the standard input stream.
/// </summary>
/// <returns>The character read from the console.</returns>
char Read() {
    return (char)getchar();
}

/// <summary>
/// Reads the next line of characters from the standard input stream safely into a pre-allocated buffer.
/// </summary>
/// <param name="buffer">The target character array to fill. Length is read at runtime to prevent overflow.</param>
void ReadLine(char[] buffer) { // <-- Change 'refvar char[]' to 'char[]'
    var int i = 0;
    var int limit = buffer.Length - 1; // Reserve space for the null terminator
    var int ch = getchar();

    // Loop until we hit a newline (10), EOF (-1), or fill up the buffer safely
    while (ch != 10 && ch != -1 && i < limit) {
        buffer[i] = (char)ch;
        i = i + 1;
        ch = getchar();
    }

    buffer[i] = (char)0; // Safe null terminator injection
}
