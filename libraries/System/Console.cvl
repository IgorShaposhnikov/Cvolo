namespace System.Console;

// Low-level C runtime bindings
extern void printf(string format, ...);
extern int getchar();

/// <summary>
/// Writes the specified string value, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(string value) {
    printf("%s\n", value);
}

/// <summary>
/// Writes the specified 32-bit signed integer, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(int value) {
    printf("%d\n", value);
}

/// <summary>
/// Writes the specified 32-bit float, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(float value) {
    printf("%f\n", (double)value);
}

/// <summary>
/// Writes the specified 64-bit double, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(double value) {
    printf("%f\n", value); 
}

/// <summary>
/// Writes the specified native signed integer, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(nint value) {
    printf("%lld\n", value);
}

/// <summary>
/// Writes the specified native unsigned integer, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(nuint value) {
    printf("%llu\n", value);
}

/// <summary>
/// Writes the specified boolean value (1 for true, 0 for false), followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(bool value) {
    printf("%d\n", value);
}

/// <summary>
/// Writes the specified character, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(char value) {
    printf("%c\n", value);
}

/// <summary>
/// Writes the specified 8-bit unsigned integer, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(byte value) {
    printf("%hhu\n", (int)value);
}

/// <summary>
/// Writes the specified 8-bit signed integer, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(sbyte value) {
    printf("%hhd\n", (int)value);
}

/// <summary>
/// Writes the specified 16-bit signed integer, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(short value) {
    printf("%hd\n", (int)value);
}

/// <summary>
/// Writes the specified 16-bit unsigned integer, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(ushort value) {
    printf("%hu\n", (int)value);
}

/// <summary>
/// Writes the specified 32-bit unsigned integer, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(uint value) {
    printf("%u\n", (int)value);
}

/// <summary>
/// Writes the specified 64-bit signed integer, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(long value) {
    printf("%lld\n", value);
}

/// <summary>
/// Writes the specified 64-bit unsigned integer, followed by the current line terminator, to stdout.
/// </summary>
void WriteLine(ulong value) {
    printf("%llu\n", value);
}

/// <summary>
/// Writes the specified string value to stdout without a line terminator.
/// </summary>
void Write(string value) {
    printf("%s", value);
}

/// <summary>
/// Writes the specified 32-bit signed integer to stdout without a line terminator.
/// </summary>
void Write(int value) {
    printf("%d", value);
}

/// <summary>
/// Writes the specified 32-bit float to stdout without a line terminator.
/// </summary>
void Write(float value) {
    printf("%f", (double)value);
}

/// <summary>
/// Writes the specified 64-bit double to stdout without a line terminator.
/// </summary>
void Write(double value) {
    printf("%f", value);
}

/// <summary>
/// Writes the specified native signed integer to stdout without a line terminator.
/// </summary>
void Write(nint value) {
    printf("%lld", value);
}

/// <summary>
/// Writes the specified native unsigned integer to stdout without a line terminator.
/// </summary>
void Write(nuint value) {
    printf("%llu", value);
}

/// <summary>
/// Writes the specified boolean value to stdout without a line terminator.
/// </summary>
void Write(bool value) {
    printf("%d", value);
}

/// <summary>
/// Writes the specified character to stdout without a line terminator.
/// </summary>
void Write(char value) {
    printf("%c", value);
}

/// <summary>
/// Writes the specified 8-bit unsigned integer to stdout without a line terminator.
/// </summary>
void Write(byte value) {
    printf("%hhu", (int)value);
}

/// <summary>
/// Writes the specified 8-bit signed integer to stdout without a line terminator.
/// </summary>
void Write(sbyte value) {
    printf("%hhd", (int)value);
}

/// <summary>
/// Writes the specified 16-bit signed integer to stdout without a line terminator.
/// </summary>
void Write(short value) {
    printf("%hd", (int)value);
}

/// <summary>
/// Writes the specified 16-bit unsigned integer to stdout without a line terminator.
/// </summary>
void Write(ushort value) {
    printf("%hu", (int)value);
}

/// <summary>
/// Writes the specified 32-bit unsigned integer to stdout without a line terminator.
/// </summary>
void Write(uint value) {
    printf("%u", (int)value);
}

/// <summary>
/// Writes the specified 64-bit signed integer to stdout without a line terminator.
/// </summary>
void Write(long value) {
    printf("%lld", value);
}

/// <summary>
/// Writes the specified 64-bit unsigned integer to stdout without a line terminator.
/// </summary>
void Write(ulong value) {
    printf("%llu", value);
}

/// <summary>
/// Reads the next character code from stdin (returns -1 on EOF).
/// </summary>
int Read() {
    return getchar();
}

/// <summary>
/// Reads characters from stdin into the provided buffer until newline or EOF.
/// </summary>
void ReadLine(char[] buffer) {
    var int i = 0;
    var int limit = buffer.Length - 1;
    var int ch = getchar();

    while (ch != 10 && ch != -1 && i < limit) {
        buffer[i] = (char)ch;
        i = i + 1;
        ch = getchar();
    }

    buffer[i] = (char)0;
}