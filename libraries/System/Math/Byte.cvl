/// <summary>
/// Unsigned 8-bit integer math helpers backing System.Math.
/// </summary>
namespace System.Math.Byte;

/// <summary>
/// Largest representable byte value.
/// </summary>
public global byte MaxValue = 255;

/// <summary>
/// Smallest representable byte value.
/// </summary>
public global byte MinValue = 0;

/// <summary>
/// Returns the smaller of two bytes.
/// </summary>
[Intrinsic("umin")]
public byte Min(byte x, byte y);

/// <summary>
/// Returns the larger of two bytes.
/// </summary>
[Intrinsic("umax")]
public byte Max(byte x, byte y);

/// <summary>
/// Clamps <paramref name="value"/> to the inclusive range [lo, hi].
/// </summary>
/// <remarks>
/// No clamping when lo &gt; hi; the result degenerates in that case, so lo/hi must be ordered by the caller.
/// </remarks>
public byte Clamp(byte value, byte lo, byte hi)
{
    return Max(lo, Min(hi, value));
}

/// <summary>
/// Number of leading zero bits of <paramref name="x"/> (0..8); x == 0 yields 8.
/// </summary>
[Intrinsic("ctlz")]
public byte LeadingZeros(byte x);

/// <summary>
/// Number of trailing zero bits of <paramref name="x"/> (0..8); x == 0 yields 8.
/// </summary>
[Intrinsic("cttz")]
public byte TrailingZeros(byte x);

/// <summary>
/// Number of 1 bits set in <paramref name="x"/> (0..8).
/// </summary>
[Intrinsic("ctpop")]
public byte PopCount(byte x);

/// <summary>
/// Rotates <paramref name="x"/> left by <paramref name="amount"/> bits.
/// </summary>
/// <remarks>
/// The amount is masked to the 3 low bits (0..7), matching LLVM funnel-shift semantics.
/// </remarks>
[Intrinsic("rotl")]
public byte RotateLeft(byte x, uint amount);

/// <summary>
/// Rotates <paramref name="x"/> right by <paramref name="amount"/> bits.
/// </summary>
/// <remarks>
/// The amount is masked to the 3 low bits (0..7), matching LLVM funnel-shift semantics.
/// </remarks>
[Intrinsic("rotr")]
public byte RotateRight(byte x, uint amount);
