/// <summary>
/// Unsigned 16-bit integer math helpers backing System.Math.
/// </summary>
namespace System.Math.UShort;

/// <summary>
/// Largest representable unsigned short value.
/// </summary>
public global ushort MaxValue = 65535;

/// <summary>
/// Smallest representable unsigned short value.
/// </summary>
public global ushort MinValue = 0;

/// <summary>
/// Returns the smaller of two unsigned shorts.
/// </summary>
[Intrinsic("umin")]
public ushort Min(ushort x, ushort y);

/// <summary>
/// Returns the larger of two unsigned shorts.
/// </summary>
[Intrinsic("umax")]
public ushort Max(ushort x, ushort y);

/// <summary>
/// Clamps <paramref name="value"/> to the inclusive range [lo, hi].
/// </summary>
/// <remarks>
/// No clamping when lo &gt; hi; the result degenerates in that case, so lo/hi must be ordered by the caller.
/// </remarks>
public ushort Clamp(ushort value, ushort lo, ushort hi) { return Max(lo, Min(hi, value)); }

/// <summary>
/// Number of leading zero bits of <paramref name="x"/> (0..16); x == 0 yields 16.
/// </summary>
[Intrinsic("ctlz")]
public ushort LeadingZeros(ushort x);

/// <summary>
/// Number of trailing zero bits of <paramref name="x"/> (0..16); x == 0 yields 16.
/// </summary>
[Intrinsic("cttz")]
public ushort TrailingZeros(ushort x);

/// <summary>
/// Number of 1 bits set in <paramref name="x"/> (0..16).
/// </summary>
[Intrinsic("ctpop")]
public ushort PopCount(ushort x);

/// <summary>
/// Reverses the byte order of <paramref name="x"/> (byte swap for a 16-bit value).
/// </summary>
[Intrinsic("bswap")]
public ushort ByteSwap(ushort x);

/// <summary>
/// Rotates <paramref name="x"/> left by <paramref name="amount"/> bits.
/// </summary>
/// <remarks>
/// The amount is masked to the 4 low bits (0..15), matching LLVM funnel-shift semantics.
/// </remarks>
[Intrinsic("rotl")]
public ushort RotateLeft(ushort x, uint amount);

/// <summary>
/// Rotates <paramref name="x"/> right by <paramref name="amount"/> bits.
/// </summary>
/// <remarks>
/// The amount is masked to the 4 low bits (0..15), matching LLVM funnel-shift semantics.
/// </remarks>
[Intrinsic("rotr")]
public ushort RotateRight(ushort x, uint amount);