/// <summary>
/// Mathematical constants shared across the System.Math namespaces.
/// </summary>
namespace System.Math.Constants;

/// <summary>
/// The ratio of a circle's circumference to its diameter (3.14159...), double precision.
/// </summary>
public global double PI = 3.14159265358979323846;

/// <summary>
/// The base of the natural logarithm (2.71828...), double precision.
/// </summary>
public global double E = 2.71828182845904523536;

/// <summary>
/// Two times pi (6.28318...), the ratio of a circle's circumference to its radius.
/// </summary>
public global double Tau = 6.28318530717958647692;

/// <summary>
/// Quiet NaN (not a number); the result of 0.0 / 0.0.
/// </summary>
public global double NaN = 0.0 / 0.0;

/// <summary>
/// Positive infinity; the result of 1.0 / 0.0.
/// </summary>
public global double PositiveInfinity = 1.0 / 0.0;

/// <summary>
/// Negative infinity; the result of -1.0 / 0.0.
/// </summary>
public global double NegativeInfinity = -1.0 / 0.0;