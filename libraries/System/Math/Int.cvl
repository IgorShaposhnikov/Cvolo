/// <summary>
/// Signed 32-bit integer math helpers backing System.Math.
/// </summary>
namespace System.Math.Int;

/// <summary>
/// Largest representable signed int value.
/// </summary>
public global int MaxValue = 2147483647;

/// <summary>
/// Smallest representable signed int value.
/// </summary>
/// <remarks>
/// Written as -2147483647 - 1 so the literal `-2147483648` never needs a 32-bit signed literal type.
/// </remarks>
public global int MinValue = -2147483647 - 1;

/// <summary>
/// Returns the absolute value of <paramref name="value"/>.
/// </summary>
/// <remarks>
/// Int.MinValue maps to itself: -(-2147483648) overflows and wraps by design (see Abs(INT_MIN) == INT_MIN).
/// </remarks>
[Intrinsic("abs")]
public int Abs(int value);

/// <summary>
/// Returns the smaller of two signed ints.
/// </summary>
[Intrinsic("smin")]
public int Min(int x, int y);

/// <summary>
/// Returns the larger of two signed ints.
/// </summary>
[Intrinsic("smax")]
public int Max(int x, int y);

/// <summary>
/// Clamps <paramref name="value"/> to the inclusive range [lo, hi].
/// </summary>
/// <remarks>
/// No clamping when lo &gt; hi; the result degenerates in that case, so lo/hi must be ordered by the caller.
/// </remarks>
public int Clamp(int value, int lo, int hi) { return Max(lo, Min(hi, value)); }

/// <summary>
/// Returns 1 for positive, -1 for negative, and 0 for zero.
/// </summary>
public int Sign(int value)
{
	if (value > 0)
	{
		return 1;
	}
	
	if (value < 0) 
	{
		return -1;
	}

	return value;
}

/// <summary>
/// Number of leading zero bits of <paramref name="x"/> (0..32); x == 0 yields 32.
/// </summary>
[Intrinsic("ctlz")]
public int LeadingZeros(int x);

/// <summary>
/// Number of trailing zero bits of <paramref name="x"/> (0..32); x == 0 yields 32.
/// </summary>
[Intrinsic("cttz")]
public int TrailingZeros(int x);

/// <summary>
/// Number of 1 bits set in <paramref name="x"/> (0..32).
/// </summary>
[Intrinsic("ctpop")]
public int PopCount(int x);

/// <summary>
/// Reverses the byte order of <paramref name="x"/> (byte swap for a 32-bit value).
/// </summary>
[Intrinsic("bswap")]
public int ByteSwap(int x);

/// <summary>
/// Rotates <paramref name="x"/> left by <paramref name="amount"/> bits.
/// </summary>
/// <remarks>
/// The amount is masked to the 5 low bits (0..31), matching LLVM funnel-shift semantics.
/// </remarks>
[Intrinsic("rotl")]
public int RotateLeft(int x, uint amount);

/// <summary>
/// Rotates <paramref name="x"/> right by <paramref name="amount"/> bits.
/// </summary>
/// <remarks>
/// The amount is masked to the 5 low bits (0..31), matching LLVM funnel-shift semantics.
/// </remarks>
[Intrinsic("rotr")]
public int RotateRight(int x, uint amount);
