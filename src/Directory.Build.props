<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.5-alpha.1</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Tooling artifact identity is separate from the compiler product Version.
      Tooling revisions may use repository-defined X.Y.Z.W identities (for example 0.0.5.1,
      then 0.0.5.2) while the compiler itself can remain on its own prerelease/version line.
      All values are overridable via -p:Name=...
    -->
    <ToolingVersion Condition="'$(ToolingVersion)' == ''">0.0.5.8</ToolingVersion>
    <CompilerCompatibilityLine Condition="'$(CompilerCompatibilityLine)' == ''">0.0</CompilerCompatibilityLine>
    <CvoloCompilerVersion Condition="'$(CvoloCompilerVersion)' == ''">$(Version)</CvoloCompilerVersion>
  </PropertyGroup>
</Project>
