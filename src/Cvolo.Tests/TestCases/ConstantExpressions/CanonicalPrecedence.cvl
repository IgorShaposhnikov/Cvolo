// Canonical static-array extent regression: `2 + 3 * 4` must use ordinary
// precedence (14, not left-to-right 20). Keep in sync with
// ConstantExpressionTests.ExtentUsesOrdinaryExpressionSemantics.
using System;

global int GlobalValue = 2 + 3 * 4;

int main() {
    var int[2 + 3 * 4] values = {};
    Console.WriteLine($"global={GlobalValue}");
    Console.WriteLine($"array-bytes={sizeof<int[2 + 3 * 4]>()}");
    return 0;
}
