using System;

void process(int x) {
    Console.WriteLine($"By Value: {x}");
}

void process(ref int x) {
    Console.WriteLine($"By Reference: {x}");
}

int main() {
    val x = 42;
    process(x);        // Should resolve to process(int)
    process(ref x);    // Should resolve to process(ref int)
    return 0;
}
