using System;

void printValue(int x) {
    Console.WriteLine($"Int: {x}");
}

void printValue(double x) {
    Console.WriteLine($"Double: {x}");
}

void printValue(string x) {
    Console.WriteLine($"String: {x}");
}

int main() {
    printValue(10);
    printValue(3.14);
    printValue("Hello Overloading!");
    return 0;
}
