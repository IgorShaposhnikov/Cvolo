using System;

struct Range {
    int Start;
    int End;
}

struct RangeEnumerator {
    int Value;
    int End;
}

extension Range {
    RangeEnumerator GetEnumerator() {
        return RangeEnumerator { Value: Start - 1, End: End };
    }
}

extension RangeEnumerator {
    bool MoveNext() {
        Value = Value + 1;
        return Value <= End;
    }

    int Current() {
        return Value;
    }
}

int Main()
{
    var Range r(Start: 0, End: 3);
    foreach (refvar int item in r) {
        Console.Write(item);
        Console.Write(",");
    }
    return 0;
}