using System;

struct Range {
    int Start;
    int End;
}

extension Range {
    RangeEnumerator GetEnumerator() {
        return RangeEnumerator { Value: Start - 1, End: End };
    }
}

struct RangeEnumerator {
    int Value;
    int End;
}

extension RangeEnumerator {
    bool MoveNext() {
        Value = Value + 1;
        return Value <= End;
    }

    int Current() {
        return Value;
    }
}

int Main()
{
    var Range r(Start: 1, End: 5);
    foreach (val item in r) {
        if (item == 3) {
            continue;
        }
        if (item == 5) {
            break;
        }
        Console.Write(item);
        Console.Write(",");
    }
    return 0;
}