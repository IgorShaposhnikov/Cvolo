interface IWidget {
    void Print();
    int Value();
}

struct Point {
    int X;
    int Y;
}

extension Point : IWidget {
    void Print() {
        printf("Point(%d,%d)\n", X, Y);
    }
    int Value() {
        return X + Y;
    }
}

struct Foo {
    int A;
}

void Draw(IWidget w) {
    w.Print();
}

int main() {
    Foo f = Foo { A: 1 };
    Draw(f);
    return 0;
}
