using System;

interface IDrawable {
    void Draw();
    int Id();
}

struct Player {
    int Health;
}

struct Enemy {
    int Health;
}

extension Player : IDrawable {
    void Draw() {
        Console.WriteLine($"Player(h={Health})");
    }
    int Id() {
        return Health * 2;
    }
}

extension Enemy : IDrawable {
    void Draw() {
        Console.WriteLine($"Enemy(h={Health})");
    }
    int Id() {
        return Health * 3;
    }
}

void Render(IDrawable d) {
    d.Draw();
    Console.WriteLine($"Id: {d.Id()}");
}

void Boost(refvar IDrawable d) {
    d.Draw();
}

int main() {
    var Player p;
    p.Health = 10;
    var Enemy e;
    e.Health = 4;

    Render(p);
    Render(e);
    Boost(ref p);

    return 0;
}
