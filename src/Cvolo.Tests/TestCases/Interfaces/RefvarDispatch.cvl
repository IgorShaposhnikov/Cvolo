using System;

interface IShape {
    void Scale(int factor);
    int Area();
}

struct Rect {
    int W;
    int H;
}

extension Rect : IShape {
    void Scale(int f) {
        W = W * f;
        H = H * f;
    }
    int Area() {
        return W * H;
    }
}

void ApplyScale(refvar IShape s, int factor) {
    s.Scale(factor);
}

int main() {
    var Rect r;
    r.W = 3;
    r.H = 4;
    ApplyScale(ref r, 2);
    Console.WriteLine($"Area: {r.Area()}");
    return 0;
}
