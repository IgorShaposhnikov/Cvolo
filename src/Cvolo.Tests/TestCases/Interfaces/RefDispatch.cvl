using System;

interface IWidget {
    void Print();
    int Value();
}

struct Point {
    int X;
    int Y;
}

extension Point : IWidget {
    void Print() {
        Console.WriteLine($"Point({X},{Y})");
    }
    int Value() {
        return X + Y;
    }
}

void Draw(ref IWidget w) {
    w.Print();
    Console.WriteLine($"Value: {w.Value()}");
}

int main() {
    var Point p;
    p.X = 3;
    p.Y = 4;
    Draw(ref p);
    return 0;
}
