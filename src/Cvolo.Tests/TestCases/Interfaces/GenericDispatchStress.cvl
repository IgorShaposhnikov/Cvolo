/// <summary>
/// GS01/GS18: sixty-four independent generic interface dispatch specializations,
/// followed by a repeated request for the first specialization.
/// </summary>
/// <remarks>
/// Each owner produces a different concrete dispatch key even though the scalar
/// argument and interface template are shared. The repeated call must reuse the
/// first key instead of creating a sixty-fifth specialization.
/// </remarks>
