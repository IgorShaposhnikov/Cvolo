using System;

interface IWidget {
    void Print();
    int Value();
}

struct Point {
    int X;
    int Y;
}

extension Point : IWidget {
    void Print() {
        Console.WriteLine($"Point({X},{Y})");
    }
    int Value() {
        return X + Y;
    }
}

int main() {
    Point p = Point { X: 3, Y: 4 };
    p.Print();
    Console.WriteLine($"Value: {p.Value()}");
    return 0;
}
