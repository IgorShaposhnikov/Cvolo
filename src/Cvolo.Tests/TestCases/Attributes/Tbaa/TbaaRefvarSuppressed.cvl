using System;

struct Box
{
    int V;
}

// Fields mutated through a refvar borrow are NOT tagged (would alias), even unbound.
unbound int Bump(refvar Box b, int n)
{
    var i = 0;
    while (i < n)
    {
        b.V = b.V + 1;
        i = i + 1;
    }
    return b.V;
}

int main()
{
    var Box box (V: 40);
    Console.WriteLine($"Answer: {Bump(refvar box, 3)}");
    return 0;
}