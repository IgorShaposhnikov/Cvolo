using System;

struct Node
{
    int Value;
}

struct SelfRef
{
    int Id;
    refvar Node Next;
}

// A struct carrying any reference-layer field (ref/refvar/slice/interface) never
// annotates its scalar fields (Memory & Safety Spec §4.C.1), so the owned scalar
// access below must also produce no !tbaa nodes.
unbound int ReadId(SelfRef s, int k)
{
    var i = 0;
    var total = 0;
    while (i < k)
    {
        total = total + s.Id;
        i = i + 1;
    }
    return total;
}

int main()
{
    var Node n = Node { Value: 42 };
    var SelfRef s = SelfRef { Id: 1, Next: refvar n };
    Console.WriteLine($"Answer: {ReadId(s, 3)}");
    return 0;
}