// INC A / A7: [NoAlias] on an unbound reference parameter must be recognized.
// Expected: ACCEPT, output 42; emitted LLVM parameter carries 'noalias'.
// Scope: attribute validation and emission, plus explicit unsafe call boundary.
using System;

unbound void Set([NoAlias] refvar int target)
{
    target = 42;
}

int Main()
{
    var int value = 0;

    // [NoAlias] is an optimizer promise: the call must be made explicitly unsafe.
    // The local value has no competing alias in this test.
    unsafe
    {
        Set(refvar value);
    }
    Console.WriteLine(value);

    return 0;
}
