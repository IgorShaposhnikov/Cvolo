// UnknownColorEquals (S21): Unresolved Color yields CVL4135; BaseColor is not a missing field.

public struct Point
{
    public int X;
    public int Y;
    public Color BaseColor;
}

int main()
{
    val p = Point {
        X = 1,
        Y = 2,
        BaseColor = (R: 255, G: 0, B: 0)
    };
    return 0;
}
