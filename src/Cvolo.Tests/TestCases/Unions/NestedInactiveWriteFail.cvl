// Box is initialized with A active. Writing b.A.Value is legal because A is proven,
// but writing b.B.Value would write through the inactive B variant. Expected: CVL1607
// on the second write.

struct Item
{
    int Value;
}

union Box
{
    Item A;
    Item B;
}

int main()
{
    var b = Box
    {
        A = Item
        {
            Value = 1
        }
    };
    b.A.Value = 2;
    b.B.Value = 3;
    return 0;
}
