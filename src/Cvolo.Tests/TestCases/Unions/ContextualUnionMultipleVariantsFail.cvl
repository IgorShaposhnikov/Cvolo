// A union holds exactly one payload. This initializer names both Number and Text, so
// validation must stop it before any tag or payload is emitted. Expected: CVL4118.

using System;

union Choice
{
    int Number;
    string Text;
}

struct Wrapper
{
    Choice Value;
}

int main()
{
    var a = Wrapper
    {
        Value = (Number: 1, Text: "x")
    };
    return 0;
}
