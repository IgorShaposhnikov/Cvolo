// Result<int, TestError>(0) is the Ok constructor: it tags the value as Ok and stores 0.
// The is Ok binding succeeds, so the program prints 0 instead of "false".

using System;

[Error]
struct TestError
{
	public int id;
}

Result<int, TestError> Get()
{
	return Result<int, TestError>(0);
}

int Main()
{
	val result = Get();
	if (result is Ok okValue)
	{
		Console.WriteLine(okValue);
	}
	else
	{
		Console.WriteLine("false");
	}

	return 0;
}
