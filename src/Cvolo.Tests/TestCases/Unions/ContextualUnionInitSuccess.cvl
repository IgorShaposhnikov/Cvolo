// Every struct here holds a union field. The (Variant: value) syntax gets the expected
// union type from that field, so the compiler writes the tag and payload in place. The
// four values cover int, string, void and a nested struct payload; the is bindings read
// them back. Expected output: 42 / Hello / None / 5,10.

using System;

union Choice
{
    int Number;
    string Text;
    void None;
}

struct Wrapper
{
    Choice Value;
}

struct Point
{
    int X;
    int Y;
}

union Location
{
    Point Coordinates;
    int Index;
}

struct Container
{
    Location Value;
}

int main()
{
    // int payload for the Number variant.
    var a = Wrapper
    {
        Value = (Number: 42)
    };
    // string payload for the Text variant.
    var b = Wrapper
    {
        Value = (Text: "Hello")
    };
    // void variant: only the tag is written.
    var c = Wrapper
    {
        Value = (None: void)
    };
    // nested struct payload; the inner (X: ..., Y: ...) targets Point.
    var d = Container
    {
        Value = (Coordinates: (X: 5, Y: 10))
    };

    if (a.Value is Number number)
    {
        Console.WriteLine(number);
    }
    else
    {
        return 1;
    }

    if (b.Value is Text text)
    {
        Console.WriteLine(text);
    }
    else
    {
        return 2;
    }

    if (c.Value is None)
    {
        Console.WriteLine("None");
    }
    else
    {
        return 3;
    }

    if (d.Value is Coordinates point)
    {
        Console.WriteLine($"{point.X},{point.Y}");
    }
    else
    {
        return 4;
    }

    return 0;
}
