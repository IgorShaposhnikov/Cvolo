/// <summary>
/// Verifies that compound assignment reads its target before writing it, so an inactive variant
/// target is rejected.
/// </summary>
/// <remarks>
/// Test: UnionsTests.Semantic_Rejections.
/// Fixture Role: Inactive-variant compound assignment rejection.
/// Compiler Target: Active-variant checks on read-modify-write targets.
/// Expected: CVL1607 reports variant 'B' while 'A' is active.
/// </remarks>
union Choice
{
    int A;
    int B;
}

int main()
{
    var c = Choice
    {
        A = 1
    };
    c.B += 2;
    return 0;
}
