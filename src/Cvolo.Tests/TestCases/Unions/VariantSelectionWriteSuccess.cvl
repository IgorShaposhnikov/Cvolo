// c starts with A active, then `c.B = 2` is a direct write to B. That write retags the
// union, so the following c.B read is legal and prints 2.

using System;

union Choice
{
    int A;
    int B;
}

int main()
{
    var c = Choice
    {
        A = 1
    };
    c.B = 2;
    Console.WriteLine(c.B);
    return 0;
}
