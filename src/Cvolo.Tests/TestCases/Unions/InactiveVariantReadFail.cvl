// The literal makes A active. Reading c.B would interpret the A payload bytes as B, so
// the compiler rejects this dotted read. Expected: CVL1607.

using System;

union Choice
{
    int A;
    int B;
}

int main()
{
    var c = Choice
    {
        A = 1
    };
    Console.WriteLine(c.B);
    return 0;
}
