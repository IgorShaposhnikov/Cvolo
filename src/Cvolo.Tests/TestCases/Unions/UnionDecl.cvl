// A union declaration with int, double and void variants. The literal selects Integer
// and stores 42; reading that same variant prints 42.

using System;

union MyUnion {
    int Integer;
    double Real;
    void Empty;
}

int main() {
    MyUnion u = MyUnion { Integer: 42 };
    var int x = u.Integer;
    Console.WriteLine($"Integer: {x}");
    return 0;
}
