// Number is an int variant, but this initializer supplies a string. The contextual form
// must run the same payload type check as an explicit union literal. Expected: CVL4019.

using System;

union Choice
{
    int Number;
    string Text;
}

struct Wrapper
{
    Choice Value;
}

int main()
{
    var a = Wrapper
    {
        Value = (Number: "wrong")
    };
    return 0;
}
