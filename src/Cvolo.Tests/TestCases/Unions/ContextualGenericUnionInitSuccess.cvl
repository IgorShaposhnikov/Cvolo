// GenericCase has an Option<int> field and a Result<int, TestError> field. The contextual
// (Some: 42) and (Ok: 7) initializers take the union type from those fields, so the
// compiler can choose the right tag after generic specialization. The is bindings read
// the payloads back. Expected output: 42 / 7.

using System;

[Error]
struct TestError
{
    public int Code;
}

struct GenericCase
{
    Option<int> Maybe;
    Result<int, TestError> Outcome;
}

int main()
{
    var value = GenericCase
    {
        Maybe = (Some: 42),
        Outcome = (Ok: 7)
    };

    if (value.Maybe is Some some)
    {
        Console.WriteLine(some);
    }
    else
    {
        return 1;
    }

    if (value.Outcome is Ok ok)
    {
        Console.WriteLine(ok);
    }
    else
    {
        return 2;
    }

    return 0;
}
