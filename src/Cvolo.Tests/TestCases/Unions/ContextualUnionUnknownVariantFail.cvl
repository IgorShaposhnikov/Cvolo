// Choice has Number and Text but no Missing variant. Naming Missing here must fail just
// as it would in an explicit union literal. Expected: CVL4115.

using System;

union Choice
{
    int Number;
    string Text;
}

struct Wrapper
{
    Choice Value;
}

int main()
{
    var a = Wrapper
    {
        Value = (Missing: 1)
    };
    return 0;
}
