using System;

union Maybe<T>
{
	T Some;
	void None;
}

extension Maybe<T> {
	bool IsSome()
	{
		return true;
	}
}

int main()
{
	Maybe<int> opt = Maybe<int> { Some: 100 };
	var int y = opt.Some;
	var bool b = opt.IsSome();
	var int bVal = b ? 1 : 0;
	Console.WriteLine($"Some: {y}, IsSome: {bVal}");

	Maybe<string> empty = Maybe<string> { None: void };
	Console.WriteLine("Empty option created.");
	return 0;
}
