using System;

union Option<T> {
    T Some;
    void None;
}

unsafe void CheckRawPointerNull(int* p) {
    if (p == null) {
        Console.WriteLine("Raw pointer is null as expected.");
    }
}

int main() {
    // 1. Empty option via explicit None literal (null is unsafe-only)
    Option<int> opt = Option<int> { None: void };
    Console.WriteLine("Safe Option null initialized successfully.");

    // 2. Unsafe null pointer check
    unsafe {
        int* p = null;
        CheckRawPointerNull(p);
    }

    return 0;
}
