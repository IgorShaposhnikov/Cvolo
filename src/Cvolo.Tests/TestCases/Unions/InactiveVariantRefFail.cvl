// `refvar c.B` would let Touch write through the inactive B payload, bypassing the
// active-variant check. Taking that address is rejected. Expected: CVL1607.

union Choice
{
    int A;
    int B;
}

void Touch(refvar int value)
{
    value = 9;
}

int main()
{
    var c = Choice
    {
        A = 1
    };
    Touch(refvar c.B);
    return 0;
}
