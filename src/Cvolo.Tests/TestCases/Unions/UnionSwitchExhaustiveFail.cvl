// MyUnion has A and B. The switch handles only A, so it must be rejected as
// non-exhaustive rather than falling through an uninitialized B payload.

union MyUnion {
    int A;
    double B;
}

int main() {
    var MyUnion u = MyUnion { A: 10 };
    switch (u) {
        case A x:
            break;
        // FAIL: Missing case for variant 'B'!
    }
    return 0;
}
