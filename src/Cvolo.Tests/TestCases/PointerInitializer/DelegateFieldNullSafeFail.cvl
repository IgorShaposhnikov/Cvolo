using System;

// A delegate-valued field does not gain nullability from the raw-pointer rule: in safe code the
// `null` is rejected by the safety rule alone, not as a pointer-field conversion.
unsafe "C" delegate int Callback(int x);

struct Holder {
	Callback Fn;
	int Tag;
}

int main() {
	Holder h = Holder { Fn = null, Tag = 1 };
	Console.WriteLine(1);
	return 0;
}
