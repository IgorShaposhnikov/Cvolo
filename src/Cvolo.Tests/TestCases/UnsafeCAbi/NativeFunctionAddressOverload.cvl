unsafe "C" delegate int IntProc(int value);

unsafe "C" int Convert(int value)
{
    return value + 1;
}

unsafe "C" float Convert(float value)
{
    return value + 10.0f;
}

int main()
{
    unsafe
    {
        IntProc proc = &Convert;
        if (proc(41) != 42)
        {
            return 1;
        }
    }

    return 0;
}
