unsafe "C" delegate int Callback(int value);

unsafe "C" int Increment(int value)
{
    return value + 1;
}

struct Holder
{
    Callback Proc;
}

int main()
{
    unsafe
    {
        Holder holder = Holder { Proc: &Increment };
        if (holder.Proc(41) != 42)
        {
            return 1;
        }
    }

    return 0;
}
