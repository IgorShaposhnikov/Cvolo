unsafe "C" delegate int UnaryProc(int value);

unsafe "C" int Increment(int value)
{
    return value + 1;
}

int Apply(UnaryProc proc, int value)
{
    var result = 0;
    unsafe
    {
        result = proc(value);
    }
    return result;
}

int main()
{
    unsafe
    {
        if (Apply(&Increment, 41) != 42)
        {
            return 1;
        }
    }

    return 0;
}
