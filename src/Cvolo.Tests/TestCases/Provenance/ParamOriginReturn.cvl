using System;

struct Point {
    int X;
    int Y;
}

ref Point ChooseFirst(ref Point callerOwned, ref Point other) {
    return callerOwned;
}

int main() {
    var Point p1 = Point { X: 10, Y: 20 };
    var Point p2 = Point { X: 30, Y: 40 };
    ChooseFirst(ref p1, ref p2);
    Console.WriteLine(p1.X);
    return 0;
}
