// TypePosition (G12): ACCEPT: adjacent closing angles remain legal in a declared variable type.

public struct Pair<T, R>
{
    public T Value1;
    public R Value2;
}

int main()
{
    // Adjacent generic closers are two ordinary GT tokens in a type position.
    Pair<Pair<int, int>, int> p = Pair<Pair<int, int>, int> {
        Value1: Pair<int, int> {
            Value1: 1,
            Value2: 2
        },
        Value2: 3
    };
    return 0;
}
