// MissingFinalArgument (G05): REJECT: a comma must be followed by a type argument.

public struct Pair<T, R>
{
    public T Value1;
    public R Value2;
}

int main()
{
    // Exercise the generic syntax at this initializer.
    val p = Pair<int, > {
        Value1: 1,
        Value2: 2
    };
    return 0;
}
