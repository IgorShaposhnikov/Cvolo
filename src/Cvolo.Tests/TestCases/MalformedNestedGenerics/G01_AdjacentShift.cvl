// G01_AdjacentShift: REJECT: consecutive opening angles require a type head; report a syntax error at the second angle.
public struct Pair<T, R> { public T Value1; public R Value2; }

int main()
{
    // Exercise the generic syntax at this initializer.
    val p = Pair<<int, int>, int> { Value1: 1, Value2: 2 };
    return 0;
}
