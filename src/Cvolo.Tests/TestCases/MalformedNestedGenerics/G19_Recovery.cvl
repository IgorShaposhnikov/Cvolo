// G19_Recovery: REJECT one malformed declaration; subsequent independent generic syntax remains available.
public struct Pair<T, R> { public T Value1; public R Value2; }

int Bad() {
    // This malformed expression must not poison following declarations.
    val p = Pair< <int, int>, int> { Value1: 1, Value2: 2 };
    return 0;
}
int Good() {
    // This valid nested generic is a recovery control.
    val p = Pair<Pair<int, int>, int> { Value1: Pair<int, int> { Value1: 1, Value2: 2 }, Value2: 3 };
    return 0;
}
int main() { return Good(); }
