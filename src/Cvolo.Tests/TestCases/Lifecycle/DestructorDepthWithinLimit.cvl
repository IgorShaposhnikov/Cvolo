using System;

/// <summary>
/// A destructor chain that stays within the compiler's nesting limit (1024) and must be
/// accepted: each struct embeds the next by value, down to a leaf whose destructor runs
/// when the outermost variable leaves scope.
/// </summary>
/// <remarks>
/// Memory & Safety spec §2: the compiler enforces a maximum destructor nesting depth
/// (default 1024). This 50-level chain is well under the cap, so it must compile and
/// the leaf's destructor must fire on scope exit.
/// </remarks>
struct Leaf { int Handle; }

extension Leaf {
    ~Leaf() {
        Console.WriteLine($"dtor {Handle}");
    }
}

struct T_49 { Leaf N; int X; }
struct T_48 { T_49 N; int X; }
struct T_47 { T_48 N; int X; }
struct T_46 { T_47 N; int X; }
struct T_45 { T_46 N; int X; }
