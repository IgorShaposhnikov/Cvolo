/// <summary>Verifies that receiver markers ('ref this' / 'refvar this') are rejected
/// on free functions; they are only allowed on extension methods.</summary>
/// <remarks>Covers Increment 4.5 receiver markers: a free function attempt to declare
/// a receiver is a compile-time error, not a silent acceptance.</remarks>

void F(refvar this)
{
}

int Main()
{
	return 0;
}