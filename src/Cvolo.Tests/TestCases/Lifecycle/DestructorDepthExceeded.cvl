using System;

/// <summary>
/// A by-value struct chain deeper than the compiler's destructor-nesting limit (1024).
/// Dropping T0 would recurse once per nested owner; this must be rejected at compile time.
/// </summary>
/// <remarks>
/// Memory & Safety spec section 2: nesting beyond the depth cap is a compile error with an
/// explicit 'Cyclic destructor nesting depth exceeded' message. The leaf defines the destructor.
/// </remarks>
struct Leaf {
    int Handle;
}

extension Leaf {
    ~Leaf() {
        Console.WriteLine($"dtor {Handle}");
    }
}

