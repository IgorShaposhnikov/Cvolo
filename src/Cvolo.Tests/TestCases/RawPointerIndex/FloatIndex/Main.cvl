/// <summary>
/// Regression test: `float*` indexing must yield `float`, not the `int` the emitter's index
/// resolver used to fall back to for any non-array/slice base.
/// </summary>
using System;

[UnsafeBody]
int Main()
{
    var float[2] values = { 1.5f, 2.5f };
    float* ptr = (float*)&values;

    float x = ptr[1];
    ptr[0] = 7.25f;

    Console.WriteLine($"x={x} v0={values[0]}");
    return x == 2.5f && values[0] == 7.25f ? 0 : 1;
}