/// <summary>
/// A struct-typed index operand must be rejected by semantic analysis (CVL4183).
/// </summary>
using System;

struct Index
{
    public int Value;
}

[UnsafeBody]
int Main()
{
    var int[3] data = { 10, 20, 30 };
    int* ptr = (int*)&data;

    Index index = Index { Value: 0 };
    return ptr[index];
}