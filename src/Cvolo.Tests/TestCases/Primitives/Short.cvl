/// <summary>
/// Feature: 16-bit signed integer (short) primitive type.
/// </summary>
/// <remarks>
/// Verifies declaration, signed 16-bit value representation (-32,768 to 32,767), and standard console output.
/// </remarks>
using System;

int Main() {
    short x = (short)-32000;
    Console.WriteLine(x);
    return 0;
}
