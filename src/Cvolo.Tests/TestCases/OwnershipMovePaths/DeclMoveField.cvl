using System;

struct Resource
{
	int Id;
}

extension Resource
{
	~Resource()
	{
		Console.WriteLine($"drop={Id}");
	}
}

struct Pair
{
	Resource First;
	Resource Second;
}

int main()
{
	var Pair pair = Pair { First: Resource { Id: 1 }, Second: Resource { Id: 2 } };
	var Resource x = pair.First;
	Console.WriteLine($"x={x.Id} other={pair.Second.Id}");
	return 0;
}
