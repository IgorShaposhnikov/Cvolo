// A loop condition IsLive proof is valid only inside the loop body. The guarded move is legal;
// after the loop the slot has no static proof and cannot be read without a fresh query.
using System;

struct Resource
{
    int Id;
}

extension Resource
{
    ~Resource()
    {
        Console.WriteLine($"drop={Id}");
    }
}

void Consume(Resource value)
{
    Console.WriteLine($"consume={value.Id}");
}

int main()
{
    var Resource[2] values;
    int i = 0;
    values[i] = Resource { Id: 7 };
    while (values.IsLive(i))
    {
        Consume(values[i]);
        break;
    }
    return 0;
}
