// Proofs do not survive a branch join, and one branch consumes the element. A read after the
// join has no evidence that the slot is still live and must be rejected with CVL4221.
using System;

struct Resource
{
    int Id;
}

extension Resource
{
    ~Resource()
    {
        Console.WriteLine($"drop={Id}");
    }
}

void Consume(Resource value)
{
    Console.WriteLine($"consume={value.Id}");
}

int main()
{
    var Resource[2] values;
    int i = 0;
    values[i] = Resource { Id: 7 };
    if (values.IsLive(i))
    {
        Consume(values[i]);
    }
    Consume(values[i]);
    return 0;
}
