using System;

struct Resource { int Id; }

extension Resource
{
    ~Resource()
    {
        Console.WriteLine($"drop={Id}");
    }
}

void Consume(Resource r)
{
    Console.WriteLine($"consume={r.Id}");
}

int main()
{
    var Resource[2] values;
    int i = 0;
    values[i] = Resource { Id: 7 };
    var Resource other = Resource { Id: 1 };
    if (values.IsLive(i))
    {
        other = values[i];
        Console.WriteLine($"q={values.IsLive(i)}");
        Consume(other);
    }
    return 0;
}
