// An IsLive true branch proves this exact slot is owned, so it may be moved to a consumer. The
// slot is marked unavailable and is not destroyed again by the array cleanup.
using System;

struct Resource
{
    int Id;
}

extension Resource
{
    ~Resource()
    {
        Console.WriteLine($"drop={Id}");
    }
}

void Consume(Resource value)
{
    Console.WriteLine($"consume={value.Id}");
}

int main()
{
    var Resource[2] values;
    int i = 0;
    values[i] = Resource { Id: 7 };
    if (values.IsLive(i))
    {
        Consume(values[i]);
    }
    return 0;
}
