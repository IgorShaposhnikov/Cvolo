// A dynamic write into a never-initialized element only installs ownership. No destructor runs
// for the old (unavailable) slot; scope exit drops the installed resource exactly once.
using System;

struct Resource
{
    int Id;
}

extension Resource
{
    ~Resource()
    {
        Console.WriteLine($"drop={Id}");
    }
}

int main()
{
    var Resource[2] values;
    int i = 0;
    values[i] = Resource { Id: 1 };
    return 0;
}
