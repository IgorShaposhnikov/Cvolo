using System;

struct Resource { int Id; }

extension Resource
{
    ~Resource()
    {
        Console.WriteLine($"drop={Id}");
    }
}

Resource TakeSelected()
{
    var Resource[2] values;
    int i = 0;
    values[i] = Resource { Id: 7 };
    if (values.IsLive(i))
        return values[i];
    return Resource { Id: 0 };
}

int main()
{
    var selected = TakeSelected();
    Console.WriteLine($"got={selected.Id}");
    return 0;
}
