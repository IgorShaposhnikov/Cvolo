using System;

struct Resource
{
    int Handle;
}

extension Resource
{
    ~Resource()
    {
        Console.WriteLine($"Dropping: {Handle}");
    }
}

void Consume(Option<Resource> opt)
{
    if (ref opt is Some resource)
    {
        Console.WriteLine($"in consume, some={resource.Handle}");
    }
    else
    {
        Console.WriteLine("in consume, none");
    }
}

int main()
{
    Option<Resource> a = Option<Resource>
    {
        Some = Resource
        {
            Handle = 7
        }
    };
    Consume(a);
    Console.WriteLine("Done");
    return 0;
}
