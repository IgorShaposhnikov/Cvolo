using System;

struct Big {
    int A;
    int B;
    int C;
    int D;
    int E;
    int F;
}

void consume(Option<Big> o) {
    Console.WriteLine($"got: {o.Some.A}");
}

int main() {
    var Option<Big> o = Option<Big> { Some: Big { A: 1, B: 2, C: 3, D: 4, E: 5, F: 6 } };
    consume(o);
    return 0;
}
