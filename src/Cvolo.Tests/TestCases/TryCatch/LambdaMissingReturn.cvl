using System;

[Error]
enum ErrorCodes : int
{
	NotFound = 1,
	NetworkTimeout = 2
}

Result<int, ErrorCodes> Divide(int a, int b)
{
	if (b == 0)
		return Result<int, ErrorCodes> { Err: ErrorCodes.NotFound };
	return Result<int, ErrorCodes> { Ok: a / b };
}

int main()
{
	var int x = Divide(10, 0) catch (e) =>
	{
		Console.WriteLine(1);
	};
	Console.WriteLine(x);
	return 0;
}
