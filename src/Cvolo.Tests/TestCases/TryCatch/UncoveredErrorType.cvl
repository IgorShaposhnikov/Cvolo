using System;

[Error]
enum ErrorCodes : int
{
	NotFound = 1,
	NetworkTimeout = 2
}

[Error]
enum OtherErrors : int
{
	Bad = 1
}

Result<int, ErrorCodes> Divide(int a, int b)
{
	if (b == 0)
		return Result<int, ErrorCodes> { Err: ErrorCodes.NotFound };
	return Result<int, ErrorCodes> { Ok: a / b };
}

int main()
{
	var int x = 0;

	try
	{
		var int r = Divide(10, 0);
		x = r;
	}
	catch (OtherErrors.Bad)
	{
		x = 1;
	}

	Console.WriteLine(x);
	return 0;
}
