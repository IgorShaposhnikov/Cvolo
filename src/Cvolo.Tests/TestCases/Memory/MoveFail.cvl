struct Resource
{
	int Handle;
}

extension Resource {
	~Resource() {
		// destructor makes this a ResourceMove type
	}
}

void Consume(Resource r) {}

int Main() {
    var Resource r1 = Resource { Handle: 10 };
    Consume(r1); // r1 is moved (ResourceMove type)
    var int x = r1.Handle; // INTENTIONAL ERROR: Use after move!
    return 0;
}
