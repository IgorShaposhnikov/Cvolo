using System;

struct Resource {
    int Handle;
}

extension Resource {
    ~Resource() {
        Console.WriteLine($"Disposing resource handle: {Handle}");
    }
}

int main() {
    // 1. Test stack-allocated auto-destruction at block exits
    {
        var Resource r1(Handle: 100);
        // ~Resource() for r1 should be automatically called right here!
    }

    // 2. Test heap-allocated auto-destruction + allocation free
    {
        var Resource r2 = heap Resource { Handle: 200 };
        // ~Resource() should be called, and then free(r2) called here!
    }

    Console.WriteLine("Done!");
    return 0;
}
