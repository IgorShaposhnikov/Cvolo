using System;

struct Point {
    int X;
    int Y;
}

extension Point {
    void Move(int dx, int dy) {
        X = X + dx;
        Y = Y + dy;
    }
}

int main() {
    val Point p(X: 10, Y: 20);

    // ILLEGAL: Cannot invoke a mutating method on a read-only variable!
    p.Move(5, 5); 
    
    return 0;
}
