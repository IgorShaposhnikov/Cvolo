using System;

protocol IWidget {
    void Print();
    int Value();
    bool Contains(int v);
}

struct Point {
    int X;
    int Y;
}

extension Point {
    void Print() {
        Console.WriteLine($"Point({X},{Y})");
    }
    int Value() {
        return X + Y;
    }
    bool Contains(int v) {
        return X == v || Y == v;
    }
}

void Draw(IWidget w) {
    w.Print();
    Console.WriteLine($"Value: {w.Value()}");
    Console.WriteLine($"Contains4: {w.Contains(4) ? 1 : 0}");
    Console.WriteLine($"Contains7: {w.Contains(7) ? 1 : 0}");
}

int main() {
    Point p = Point { X: 3, Y: 4 };
    Draw(p);
    return 0;
}