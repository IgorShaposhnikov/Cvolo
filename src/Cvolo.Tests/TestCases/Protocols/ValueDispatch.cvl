protocol IWidget {
    void Print();
    int Value();
    bool Contains(int v);
}

struct Point {
    int X;
    int Y;
}

extension Point {
    void Print() {
        printf("Point(%d,%d)\n", X, Y);
    }
    int Value() {
        return X + Y;
    }
    bool Contains(int v) {
        return X == v || Y == v;
    }
}

void Draw(IWidget w) {
    w.Print();
    printf("Value: %d\n", w.Value());
    printf("Contains4: %d\n", w.Contains(4) ? 1 : 0);
    printf("Contains7: %d\n", w.Contains(7) ? 1 : 0);
}

int main() {
    Point p = Point { X: 3, Y: 4 };
    Draw(p);
    return 0;
}