namespace App.Collections;

using System;

struct Buffer<T> {
    T[5] Elements;
    int Length;
}

struct Pair<T, U> {
    T First;
    U Second;
}

void Swap<T>(refvar T a, refvar T b) 
{
    T temp = a;
    a = b;
    b = temp;
}

int Main() 
{
    // 1. Instantiate a nested generic struct
    Pair<int, string> myPair = Pair<int, string> {
        First: 100,
        Second: "Success"
    };

    // 2. Instantiate a generic buffer struct containing a static array
    var Buffer<double> myBuffer;

    // 3. Call a generic function with type arguments
    var x = 10;
    var y = 20;

	Console.WriteLine("Before generic Swap<T>:");
    Console.WriteLine($"X: {x}, Y: {y} ");

    Swap<int>(ref x, ref y);

    Console.WriteLine("After generic Swap<T>:");
    Console.WriteLine($"X: {x}, Y: {y} ");

    Console.WriteLine("Generic execution success!");
    return 0;
}
