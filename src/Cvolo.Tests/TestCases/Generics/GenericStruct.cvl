extern void printf(string format, ...);

struct Pair<T, U> {
    T First;
    U Second;
}

int main() 
{
    Pair<int, double> p = Pair<int, double> {
        First: 42,
        Second: 3.14
    };

    var int f = p.First;
    var double s = p.Second;
    printf("First: %d, Second: %f\n", f, s);
    return 0;
}
