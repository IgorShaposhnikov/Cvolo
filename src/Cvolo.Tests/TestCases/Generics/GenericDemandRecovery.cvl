/// <summary>
/// GS18: an expanding specialization is rejected without poisoning later valid work.
/// </summary>
/// <remarks>
/// Node&lt;int&gt; demands an expanding pointee chain and must report CVL4200. The
/// Identity call follows that rejection, uses a defaulted generic argument and must
/// still be promoted to a ready specialization in the same analysis session.
/// </remarks>
using System;

struct MallocAllocator
{
}

struct Node<T>
{
    T Value;
    Node<Node<T>>* Next;
}

int Identity<T, A>(T value)
    where default A : MallocAllocator
{
    return value;
}

int main()
{
    Node<int> n = Node<int>
    {
        Value = 1
    };
    Console.WriteLine(Identity<int>(7));
    Console.WriteLine(n.Value);
    return 0;
}
