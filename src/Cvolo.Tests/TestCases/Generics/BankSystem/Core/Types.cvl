namespace BankSystem.Core;

// ============ GENERIC STRUCTURES ============

struct Transaction<T> {
    public T Amount;
    public string Currency;
    public string Description;
    public int Timestamp;
    public bool IsCompleted;
}

struct Account<T> {
    public T Balance;
    public string Currency;
    public string Owner;
    public Transaction<T>[100] History;
    public int TransactionCount;
}

struct Pair<T, U> {
    public T First;
    public U Second;
}