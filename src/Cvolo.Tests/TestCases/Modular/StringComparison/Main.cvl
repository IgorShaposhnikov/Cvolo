using System;
using Lib;

int Main() {
    string local = "Cvolo";
    string remote = GetProjectName();

    // If pointers match, it prints MATCH. 
    // Currently, IrEmitter doesn't deduplicate strings globally, so this will likely print MISMATCH.
    if (local == remote) {
        Console.WriteLine("RESULT:MATCH");
    } else {
        Console.WriteLine("RESULT:MISMATCH");
    }
    return 0;
}
