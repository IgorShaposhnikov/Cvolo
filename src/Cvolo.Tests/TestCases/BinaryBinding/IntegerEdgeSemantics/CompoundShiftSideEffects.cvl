// Compound <<= on a byte element with a VALID runtime count: arr[0] starts at 1, NextIndex()
// runs once (+1 -> counter 1), NextCount() runs once (+10 -> counter 11), and the store writes
// 1 << 2 = 4. Both observations prove exactly-once evaluation.

global var int counter = 0;

int NextIndex()
{
    counter = counter + 1;
    return 0;
}

int NextCount()
{
    counter = counter + 10;
    return 2;
}

int main()
{
    int fails = 0;
    byte[4] arr;
    arr[0] = 1;

    arr[NextIndex()] <<= NextCount();

    if (counter != 11) fails++;
    if (arr[0] != 4) fails++;

    return fails;
}