extern void* malloc(int size);
extern void free(void* ptr);

[UnsafeBody]
int Main() {
    var int* base = (int*)malloc(sizeof<int>() * 3);
    *base = 10;
    *(base + 1) = 20;
    *(base + 2) = 30;

    int* p = base + 1;
    if (p == null)
        return 2;

    int i = 1;
    int* a = p + i;
    int* b = p - i;
    int result = b < a && *a == 30 && *b == 10 ? 0 : 1;

    free((void*)base);
    return result;
}
