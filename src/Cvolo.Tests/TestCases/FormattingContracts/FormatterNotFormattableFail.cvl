// Negative case: a type that conforms to neither IFormattable nor IStringable (and is not a
// primitive, string, Option, or Result) is rejected with diagnostic CVL4193.

using System;

struct Ticket
{
    int Id;
}

int main()
{
    Ticket t = Ticket { Id: 1 };
    Console.WriteLine(t);
    return 0;
}
