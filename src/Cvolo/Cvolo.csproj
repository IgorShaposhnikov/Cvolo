<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<InformationalVersion>$(Version)</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="libLLVM.runtime.win-x64" Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == ''" />
		<PackageReference Include="libLLVM.runtime.linux-x64" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
		<PackageReference Include="libLLVM.runtime.linux-arm64" Condition="'$(RuntimeIdentifier)' == 'linux-arm64'" />
		<PackageReference Include="libLLVM.runtime.osx-arm64" Condition="'$(RuntimeIdentifier)' == 'osx-arm64'" />
		<PackageReference Include="LLVMSharp" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="System.CommandLine" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Cvolo.Core\Cvolo.Core.csproj" />
		<ProjectReference Include="..\Cvolo.Syntax\Cvolo.Syntax.csproj" />
		<ProjectReference Include="..\Cvolo.Syntax.Antlr\Cvolo.Syntax.Antlr.csproj" />
		<ProjectReference Include="..\Cvolo.Analysis\Cvolo.Analysis.csproj" />
		<ProjectReference Include="..\Cvolo.Emitter.LLVM\Cvolo.Emitter.LLVM.csproj" />
		<ProjectReference Include="..\Cvolo.CLI.Packages\Cvolo.CLI.Packages.csproj" />
		<ProjectReference Include="..\Cvolo.Projects\Cvolo.Projects.csproj" />
	</ItemGroup>

	<!--
		Release distribution contract: Cvolo ships the native clang driver it invokes.
		That clang may use platform linker/SDK/runtime components supplied by the OS.
		Copy the complete RID-specific tooling directory so support binaries added alongside
		clang are not accidentally omitted from the release payload.
	-->
	<ItemGroup Condition="('$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == '') And Exists('tooling\win-x64')">
		<None Update="tooling\win-x64\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" Visible="False" />
	</ItemGroup>
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' And Exists('tooling\linux-x64')">
		<None Update="tooling\linux-x64\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" Visible="False" />
	</ItemGroup>
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64' And Exists('tooling\linux-arm64')">
		<None Update="tooling\linux-arm64\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" Visible="False" />
	</ItemGroup>
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' And Exists('tooling\osx-arm64')">
		<None Update="tooling\osx-arm64\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" Visible="False" />
	</ItemGroup>

	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
		<None Include="..\..\libraries\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="libraries\%(RecursiveDir)%(Filename)%(Extension)" Visible="False" />
	</ItemGroup>

</Project>
