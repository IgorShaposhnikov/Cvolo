using System;

struct Node {
    Option<refvar Node> next;
    int value;
}

extension Node {
    Node(int va) {
        this.value = va;
        this.next = Option<refvar Node> { None: void };
    }
}

[SuppressWarning("CVL1010")]
unbound Option<ref Node> BuildRing(int size) {
    if (size <= 0) return Option<ref Node> { None: void };
    var Node headOwner = heap Node(0);
    refvar Node head = refvar headOwner;
    var int i = 1;
    refvar Node curr = head;
    while (i < size) {
        var Node newNodeOwner = heap Node(i);
        refvar Node newNode = refvar newNodeOwner;
        curr.next = Option<refvar Node> { Some: newNode };
        curr = newNode;
        i += 1;
    }
    curr.next = Option<refvar Node> { Some: head };
    return Option<ref Node> { Some: head };
}

int main() {
    var Option<ref Node> ringOpt = BuildRing(10000);
    var total = 0;
    switch (ref ringOpt) {
        case Some ring:
            var ref Node walker = ring;
            var int hops = 0;
            while (hops < 300000) {
                total = total + walker.value;
                var Option<ref Node> nextOpt = Option<ref Node> { None: void };
                switch (ref walker.next) {
                    case Some nextNode:
                        nextOpt = Option<ref Node> { Some: nextNode };
                    case None:
                }
                switch (ref nextOpt) {
                    case Some nxt:
                        walker = nxt;
                    case None:
                        hops = 300000;
                }
                hops += 1;
            }
        case None:
    }
    Console.WriteLine($"Answer: {total}");
    return 0;
}
