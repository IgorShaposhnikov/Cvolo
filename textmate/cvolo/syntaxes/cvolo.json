{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cvolo",
  "scopeName": "source.cvolo",
  "fileTypes": [ "cvolo", "cvl", "cv" ],
  "repository": {
    "comments": {
      "patterns": [
        { "include": "#block_comment" },
        { "include": "#line_comment" }
      ]
    },
    "block_comment": {
      "name": "comment.block.cvolo",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "line_comment": {
      "name": "comment.line.double-slash.cvolo",
      "begin": "//",
      "end": "$"
    },
    "string_literals": {
      "patterns": [
        {
          "name": "string.interpolated.cvolo",
          "begin": "$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cvolo",
              "match": "\\\\([0nrt\"\\\\])"
            }
          ]
        },
        {
          "name": "string.quoted.double.cvolo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cvolo",
              "match": "\\\\([0nrt\"\\\\])"
            }
          ]
        },
        {
          "name": "string.quoted.single.cvolo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.cvolo",
              "match": "\\\\([0nrt\"\\\\]|')"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cvolo",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.cvolo",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "name": "keyword.other.cvolo",
      "match": "\\b(val|var|ref|refvar|heap|extern|unsafe|panic|namespace|using|return|if|else|while|for|null|union|enum|unsafe|unbound|extension|interface|protocol|embed|global|switch|case|default)\\b"
    },
    "storage_modifiers": {
      "name": "storage.modifier.cvolo",
      "match": "\\b(ref|refvar|unsafe|unbound|global|extern|embed)\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.cvolo",
          "match": "\\b(void|int|uint|long|ulong|short|ushort|byte|sbyte|double|bool|string|char)\\b"
        },
        {
          "name": "storage.type.cvolo",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "keyword.operator.cvolo",
          "match": "(\\*) | (\\[\\])"
        }
      ]
    }
  },
  "patterns": [
    { "include": "#comments" },
    {
      "comment": "Using directive",
      "match": "\\b(using)\\s+([a-zA-Z0-9_.]+)",
      "captures": {
        "1": { "name": "keyword.other.cvolo" },
        "2": { "name": "entity.name.namespace.cvolo" }
      }
    },
    {
      "comment": "Namespace declaration",
      "match": "\\b(namespace)\\s+([a-zA-Z0-9_.]+)",
      "captures": {
        "1": { "name": "keyword.other.cvolo" },
        "2": { "name": "entity.name.namespace.cvolo" }
      }
    },
    {
      "comment": "Struct, Union, Enum, Interface, Protocol, Extension declaration",
      "begin": "\\b(struct|union|enum|interface|protocol|extension)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "end": "(?=\\{|:)",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier"
        },
        "2": {
          "name": "entity.name.type.class"
        }
      }
    },
    {
      "comment": "Fields and Variables",
      "match": "\\b(val|var|refvar|ref)?\\s*(void|int|uint|long|ulong|short|ushort|byte|sbyte|double|bool|string|char|[A-Z][a-zA-Z0-9_]*)\\b\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier" },
        "2": { "name": "storage.type" },
        "3": { "name": "variable.other.member" }
      }
    },
    {
      "comment": "Function definition",
      "begin": "\\b(?:(unsafe|unbound)\\s+)?(?:(ref|refvar)\\s+)?(void|int|uint|long|ulong|short|ushort|byte|sbyte|double|bool|string|char|[a-zA-Z_][a-zA-Z0-9_]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "end": "(?<=\\))",
      "beginCaptures": {
        "1": { "name": "storage.modifier" },
        "2": { "name": "storage.modifier.ref.cvolo" },
        "3": { "name": "storage.type.cvolo" },
        "4": { "name": "entity.name.function.cvolo" }
      },
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            { "include": "#types" },
            {
              "match": "\\w+",
              "name": "variable.parameter.cvolo"
            }
          ]
        }
      ]
    },
    { "include": "#string_literals" },
    { "include": "#numbers" },
    {
      "match": "\\bheap\\b",
      "name": "keyword.other.cvolo"
    },
    {
      "comment": "Member access and method calls",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\(|\\s*\\{)",
      "captures": { "1": { "name": "entity.name.function.cvolo" } }
    },
    { "include": "#keywords" },
    { "include": "#storage_modifiers" },
    {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.cvolo"
    },
    { "include": "#types" },
    {
      "comment": "All operators including compound, bitwise, ternary, and pointer",
      "name": "keyword.operator.cvolo",
      "match": "(\\+\\+|--|<<=|>>=|>>>=|\\+=|\\-=|\\*=|/=|&=|\\|=|\\^=|<<|>>|>>>|==|!=|<=|>=|&&|\\|\\||->|\\.\\.\\.|\\+|\\-|\\*|/|%|&|\\||\\^|~|!|=|\\?|:|\\[|\\]|\\.\\s|\\.\\.|\\|\\>|\\<|\\>)"
    }
  ]
}
