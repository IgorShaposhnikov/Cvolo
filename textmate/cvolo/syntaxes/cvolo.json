{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cvolo",
  "scopeName": "source.cvolo",
  "fileTypes": [ "cvolo", "cvl", "cv" ],
  "repository": {
    "comments": {
      "patterns": [
        { "include": "#block_comment" },
        { "include": "#line_comment" }
      ]
    },
    "block_comment": {
      "name": "comment.block.cvolo",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "line_comment": {
      "name": "comment.line.double-slash.cvolo",
      "begin": "//",
      "end": "$"
    },
    "string_literals": {
      "patterns": [
        {
          "name": "string.interpolated.cvolo",
          "begin": "$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cvolo",
              "match": "\\\\([0nrt\"\\\\])"
            }
          ]
        },
        {
          "name": "string.quoted.double.cvolo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cvolo",
              "match": "\\\\([0nrt\"\\\\])"
            }
          ]
        },
        {
          "name": "string.quoted.single.cvolo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.cvolo",
              "match": "\\\\([0nrt\"\\\\]|')"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cvolo",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.cvolo",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cvolo",
          "match": "\\b(return|if|else|while|for|switch|case|default|panic|namespace|using)\\b"
        },
        {
          "name": "keyword.other.cvolo",
          "match": "\\b(heap)\\b"
        }
      ]
    },
    "storage_modifiers": {
      "name": "storage.modifier.cvolo",
      "match": "\\b(private|internal|public|ref|refvar|unsafe|unbound|global|extern|embed|val|var|expose)\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.cvolo",
          "match": "\\b(void|int|uint|long|ulong|short|ushort|byte|sbyte|nint|nuint|float|double|bool|string|char)\\b"
        },
        {
          "name": "storage.type.cvolo",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "patterns": [
    { "include": "#comments" },
    {
      "comment": "Attributes list",
      "name": "meta.attribute.cvolo",
      "begin": "\\[",
      "end": "\\]",
      "patterns": [
        {
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_.]*\\b",
          "name": "entity.name.function.decorator.cvolo"
        },
        { "include": "#string_literals" },
        { "include": "#numbers" }
      ]
    },
    {
      "comment": "Using directive",
      "match": "\\b(?:(expose)\\s+)?(using)\\s+([a-zA-Z0-9_.]+)",
      "captures": {
        "1": { "name": "storage.modifier.cvolo" },
        "2": { "name": "keyword.control.cvolo" },
        "3": { "name": "entity.name.namespace.cvolo" }
      }
    },
    {
      "comment": "Namespace declaration",
      "match": "\\b(namespace)\\s+([a-zA-Z0-9_.]+)",
      "captures": {
        "1": { "name": "keyword.control.cvolo" },
        "2": { "name": "entity.name.namespace.cvolo" }
      }
    },
    {
      "comment": "Struct, Union, Enum, Interface, Protocol, Extension declaration",
      "begin": "\\b(?:(private|internal|public)\\s+)?(struct|union|enum|interface|protocol|extension)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "end": "(?=\\{|:)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.visibility.cvolo" },
        "2": { "name": "storage.modifier.cvolo" },
        "3": { "name": "entity.name.type.class.cvolo" }
      }
    },
    {
      "comment": "Extern function declaration",
      "match": "\\b(?:(private|internal|public)\\s+)?(extern)\\s+(void|int|uint|long|ulong|short|ushort|byte|sbyte|nint|nuint|float|double|bool|string|char|[A-Z][a-zA-Z0-9_]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "storage.modifier.visibility.cvolo" },
        "2": { "name": "storage.modifier.cvolo" },
        "3": { "name": "storage.type.cvolo" },
        "4": { "name": "entity.name.function.cvolo" }
      }
    },
    {
      "comment": "Function definition",
      "begin": "\\b(?:(private|internal|public)\\s+)?(?:(unsafe|unbound)\\s+)?(?:(ref|refvar)\\s+)?(void|int|uint|long|ulong|short|ushort|byte|sbyte|nint|nuint|float|double|bool|string|char|[A-Z][a-zA-Z0-9_]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?:<[^>]+>\\s*)?(?=\\()",
      "end": "(?<=\\))",
      "beginCaptures": {
        "1": { "name": "storage.modifier.visibility.cvolo" },
        "2": { "name": "storage.modifier.cvolo" },
        "3": { "name": "storage.modifier.ref.cvolo" },
        "4": { "name": "storage.type.cvolo" },
        "5": { "name": "entity.name.function.cvolo" }
      },
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            { "include": "#types" },
            {
              "match": "\\b(ref|refvar)\\b",
              "name": "storage.modifier.ref.cvolo"
            },
            {
              "match": "\\w+",
              "name": "variable.parameter.cvolo"
            }
          ]
        }
      ]
    },
    {
      "comment": "Variable declaration with explicitly defined type",
      "match": "\\b(?:(private|internal|public)\\s+)?(?:(global)\\s+)?(?:(val|var|refvar|ref)\\s+)?(void|int|uint|long|ulong|short|ushort|byte|sbyte|nint|nuint|float|double|bool|string|char|[A-Z][a-zA-Z0-9_]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b\\s*(?=\\s*(?:=|;|,|\\)|\\}))",
      "captures": {
        "1": { "name": "storage.modifier.visibility.cvolo" },
        "2": { "name": "storage.modifier.cvolo" },
        "3": { "name": "storage.modifier.cvolo" },
        "4": { "name": "storage.type.cvolo" },
        "5": { "name": "variable.other.declaration.cvolo" }
      }
    },
    {
      "comment": "Variable declaration without explicitly defined type (inferred)",
      "match": "\\b(?:(private|internal|public)\\s+)?(?:(global)\\s+)?(val|var)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "storage.modifier.visibility.cvolo" },
        "2": { "name": "storage.modifier.cvolo" },
        "3": { "name": "storage.modifier.cvolo" },
        "4": { "name": "variable.other.declaration.cvolo" }
      }
    },
    { "include": "#string_literals" },
    { "include": "#numbers" },
    {
      "comment": "Function calls and struct instantiation",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?:<[^>]+>)?\\s*(?=\\(|\\{)",
      "captures": { "1": { "name": "entity.name.function.call.cvolo" } }
    },
    { "include": "#keywords" },
    { "include": "#storage_modifiers" },
    {
      "match": "\\b(true|false|null)\\b",
      "name": "constant.language.cvolo"
    },
    { "include": "#types" },
    {
      "comment": "All operators including compound, bitwise, ternary, pointers, etc.",
      "name": "keyword.operator.cvolo",
      "match": "(\\+\\+|--|<<=|>>=|>>>=|\\+=|\\-=|\\*=|/=|&=|\\|=|\\^=|<<|>>|>>>|==|!=|<=|>=|&&|\\|\\||->|\\.\\.\\.|\\+|\\-|\\*|/|%|&|\\||\\^|~|!|=|\\?|:|\\[|\\]|\\.\\s|\\.\\.|\\|\\>|\\<|\\>)"
    }
  ]
}
