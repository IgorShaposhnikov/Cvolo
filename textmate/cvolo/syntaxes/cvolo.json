{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cvolo",
  "scopeName": "source.cvolo",
  "fileTypes": [ "cvolo", "cvl", "cv" ],
  "repository": {
    "comments": {
      "patterns": [
        { "include": "#block_comment" },
        { "include": "#line_comment" }
      ]
    },
    "block_comment": {
      "name": "comment.block.cvolo",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "line_comment": {
      "name": "comment.line.double-slash.cvolo",
      "begin": "//",
      "end": "$"
    },
    "string_literal": {
      "name": "string.quoted.double.cvolo",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cvolo",
          "match": "\\\\([0nrt\"\\\\])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cvolo",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.cvolo",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "name": "keyword.other.cvolo",
      "match": "\\b(val|var|ref|refvar|heap|ref|extern|unsafe|panic|namespace|using|return|if|else|while|for)\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.modifier.ref.cvolo",
          "match": "\\b(ref|refvar)\\b"
        },
        {
          "name": "storage.type.primitive.cvolo",
          "match": "\\b(void|int|double|bool|string|char)\\b"
        },
        {
          "name": "storage.type.cvolo",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "patterns": [
    { "include": "#comments" },
    {
      "comment": "Using directive",
      "match": "\\b(using)\\s+([a-zA-Z0-9_.]+)",
      "captures": {
        "1": { "name": "keyword.other.cvolo" },
        "2": { "name": "entity.name.namespace.cvolo" }
      }
    },
    {
      "comment": "Namespace declaration",
      "match": "\\b(namespace)\\s+([a-zA-Z0-9_.]+)",
      "captures": {
        "1": { "name": "keyword.other.cvolo" },
        "2": { "name": "entity.name.namespace.cvolo" }
      }
    },
    {
      "comment": "Struct declaration",
      "begin": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "end": "(?=\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier"
        },
        "2": {
          "name": "entity.name.type.class"
        }
      }
    },
    {
      "comment": "Struct Fields",
      "match": "\\b(int|double|bool|string|char|void)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type" },
        "2": { "name": "variable.other.member" }
      }
    },
    {
      "comment": "Function definition",
      "begin": "\\b(?:(ref|refvar)\\s+)?(void|int|double|bool|string|char|[a-zA-Z_][a-zA-Z0-9_]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "end": "(?<=\\))",
      "beginCaptures": {
        "1": { "name": "storage.modifier.ref.cvolo" },
        "2": { "name": "storage.type.cvolo" },
        "3": { "name": "entity.name.function.cvolo" }
      },
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            { "include": "#types" },
            {
              "match": "\\w+",
              "name": "variable.parameter.cvolo"
            }
          ]
        }
      ]
    },
    { "include": "#string_literal" },
    { "include": "#numbers" },
    {
      "match": "\\bheap\\b",
      "name": "keyword.other.cvolo"
    },
    {
      "comment": "Member access and method calls",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\(|\\s*\\{)",
      "captures": { "1": { "name": "entity.name.function.cvolo" } }
    },
    { "include": "#keywords" },
    {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.cvolo"
    },
    { "include": "#types" },
    {
      "comment": "All operators including compound, bitwise, and ternary",
      "name": "keyword.operator.cvolo",
      "match": "(\\+\\+|--|<<=|>>=|>>>=|\\+=|\\-=|\\*=|/=|&=|\\|=|\\^=|<<|>>|>>>|==|!=|<=|>=|&&|\\|\\||->|\\.\\.\\.|\\+|\\-|\\*|/|%|&|\\||\\^|~|!|=|\\?|:|\\[|\\])"
    }
  ]
}