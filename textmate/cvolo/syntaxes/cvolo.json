{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cvolo",
  "scopeName": "source.cvolo",
  "fileTypes": [
    "cvolo",
    "cvl",
    "cv"
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "include": "#block_comment" },
        { "include": "#line_comment" }
      ]
    },
    "block_comment": {
      "comment": "Block comment",
      "name": "comment.block.cvolo",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "line_comment": {
      "comment": "Single-line comment",
      "name": "comment.line.double-slash.cvolo",
      "begin": "//",
      "end": "$"
    },
    "string_literal": {
      "comment": "Double-quote string literal",
      "name": "string.quoted.double.cvolo",
      "begin": "\"",
      "end": "\"",
      "patterns": [ { "include": "#escaped_character" } ]
    },
    "escaped_character": {
      "name": "constant.character.escape.cvolo",
      "match": "\\\\([0nrt\"\\\\])"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cvolo",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.cvolo",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cvolo",
          "match": "\\b(return|if|else|while|for)\\b"
        },
        {
          "name": "keyword.other.cvolo",
          "match": "\\b(val|var|ref|refvar|heap|extern|unsafe|panic)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.modifier.ref.cvolo",
          "match": "\\b(ref|refvar)\\b"
        },
        {
          "name": "storage.type.primitive.cvolo",
          "match": "\\b(void|int|double|bool|string|char)\\b"
        },
        {
          "name": "storage.type.cvolo",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "patterns": [
    { "include": "#comments" },
    {
      "comment": "Struct declaration",
      "begin": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "end": "(?=\\{)",
      "beginCaptures": {
        "1": { "name": "storage.type.struct.cvolo" },
        "2": { "name": "entity.name.type.struct.cvolo" }
      }
    },
    {
      "comment": "Function definition",
      "begin": "\\b(?:(ref|refvar)\\s+)?(void|int|double|bool|string|char|[a-zA-Z_][a-zA-Z0-9_]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "end": "(?<=\\))",
      "beginCaptures": {
        "1": { "name": "storage.modifier.ref.cvolo" },
        "2": { "name": "storage.type.cvolo" },
        "3": { "name": "entity.name.function.cvolo" }
      },
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            { "include": "#types" },
            {
              "match": "\\w+",
              "name": "variable.parameter.cvolo"
            }
          ]
        }
      ]
    },
    { "include": "#string_literal" },
    { "include": "#numbers" },
    {
      "comment": "Heap allocation expression",
      "match": "\\bheap\\b",
      "name": "keyword.other.cvolo"
    },
    {
      "comment": "Function/Struct invocation",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\(|\\s*\\{)",
      "captures": { "1": { "name": "entity.name.function.cvolo" } }
    },
    {
      "comment": "Member access",
      "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": { "1": { "name": "variable.other.member.cvolo" } }
    },
    { "include": "#keywords" },
    {
      "comment": "Boolean constants",
      "name": "constant.language.boolean.cvolo",
      "match": "\\b(true|false)\\b"
    },
    { "include": "#types" },
    {
      "comment": "Operators",
      "name": "keyword.operator.cvolo",
      "match": "(\\+\\+|--|\\+|\\-|\\*|/|%|&|\\||\\^|~|!|=|==|!=|<=|>=|&&|\\|\\||\\+=|\\-=|\\*=|/=|->|\\.\\.\\.|:)"
    }
  ]
}